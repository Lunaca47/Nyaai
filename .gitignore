# Built application files
*.apk
*.aar
*.ap_
*.aab

# Allow distribution release binaries
!docs/*.apk
!release_package/binaries/*.apk


# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/
build/
app/build/
**/build/

# Gradle files
.gradle/
build/

# Local configuration file (sdk.dir, gemini.api.key, etc.)
local.properties

# Proguard folder generated by Eclipse
proguard/

# Log Files
*.log

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures folder
captures/

# IntelliJ IDEA
*.iml
.idea/
.idea/caches/
.idea/libraries/
.idea/modules.xml
.idea/workspace.xml

# Keystore and credential files
*.jks
*.keystore
*.key
*.pem
credentials.json
service-account*.json
firebase-adminsdk*.json

# Google Services / secrets in root (keep app/google-services.json if needed, ignore root duplicates)
google-services*.json
!app/google-services.json

# Environment variables
.env
.env.*
backend/.env
backend/.env.*
!backend/.env.example

# Python caches and testing
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.coverage
htmlcov/

# Local diagnostic and scratch directories
scratch/

# OS files
.DS_Store
Thumbs.db

# Fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots
fastlane/test_output
fastlane/*.json
fastlane/*.p12
Gemfile.lock


