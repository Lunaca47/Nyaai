# NYAAI FastAPI Backend Environment Configuration

# Mandatory Security & Environment
ENVIRONMENT=development # Required: "development", "test", or "production"
AUTH_SECRET_KEY=your_cryptographically_secure_random_hmac_secret_key_here # Required in production/development

# Allowed CORS Origins (comma-separated, optional - defaults include https://lunaca47.github.io and localhost)
CORS_ORIGINS=https://lunaca47.github.io,http://localhost:8000,http://localhost:3000

# Primary Databases & Vector Store
DATABASE_URL=postgresql+asyncpg://nyaai:nyaai@localhost:5432/nyaai
QDRANT_URL=http://localhost:6333
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# LLM Providers (Keep secret on server, NEVER share with client)
LLM_PROVIDER=gemini # "gemini", "anthropic", or "ollama"
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma2:2b

# Embedding & Cross-Encoder Models
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
ALLOW_IN_MEMORY_FALLBACK=True
